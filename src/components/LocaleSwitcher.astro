---
import { getCollection } from 'astro:content';
import { LEGAL_ROUTES, type Lang, type LegalKey } from '../lib/site';
import {
  articleSlug,
  authorSlug,
  categoryHref,
  collectAuthors,
  collectTags,
  homeHref,
  LANGS,
  LANG_PREFIX,
} from '../lib/articles';

interface Props {
  lang: Lang;
  currentPath: string;
}

const { lang, currentPath } = Astro.props;

// Etiquetas de cada idioma en el selector.
const LANG_LABEL: Record<Lang, string> = { en: 'EN', es: 'ES', ca: 'CA' };

const published = await getCollection('articles', ({ data }) => data.published);

// Índice `${lang}:${key}` -> slug del artículo en ese idioma.
const translationIndex = new Map<string, string>();
for (const a of published) {
  translationIndex.set(`${a.data.lang}:${a.data.translationKey ?? articleSlug(a)}`, articleSlug(a));
}

// Rutas que existen en cada idioma, derivadas del contenido real.
const pathsByLang: Record<Lang, Set<string>> = {
  es: new Set<string>(['/']),
  en: new Set<string>(['/en/']),
  ca: new Set<string>(['/ca/']),
};

for (const a of published) {
  const slug = articleSlug(a);
  pathsByLang[a.data.lang].add(`${LANG_PREFIX[a.data.lang]}/${slug}/`);
}
for (const category of new Set(published.map((a) => a.data.category))) {
  for (const l of LANGS) pathsByLang[l].add(categoryHref(category, l));
}
for (const l of LANGS) {
  for (const entry of collectTags(published.filter((a) => a.data.lang === l))) {
    pathsByLang[l].add(`${LANG_PREFIX[l]}/tag/${entry.slug}/`);
  }
  for (const name of collectAuthors(published.filter((a) => a.data.lang === l)).keys()) {
    pathsByLang[l].add(`${LANG_PREFIX[l]}/autor/${authorSlug(name)}/`);
  }
}

// Legales: cada idioma tiene su propia ruta, así que no se derivan por prefijo.
// Mapa ruta -> clave legal, para traducir cualquier legal a su equivalente.
const LEGAL_KEYS: LegalKey[] = ['privacy', 'terms', 'legalNotice'];
const legalByRoute = new Map<string, LegalKey>();
for (const key of LEGAL_KEYS) {
  for (const l of LANGS) legalByRoute.set(LEGAL_ROUTES[key][l], key);
}

// Detecta el idioma de una ruta por su prefijo.
function routeLang(path: string): Lang {
  if (path.startsWith('/en/') || path === '/en') return 'en';
  if (path.startsWith('/ca/') || path === '/ca') return 'ca';
  return 'es';
}

function buildHref(target: Lang): string | null {
  const path = currentPath.split('?')[0] ?? '/';
  const known = pathsByLang[target];
  if (known.has(path)) return path;

  const from = routeLang(path);
  if (target === from) return path;

  // Legales: los nombres de ruta difieren por idioma (/ca/privacitat/ vs /privacy/).
  const legalKey = legalByRoute.get(path);
  if (legalKey) {
    const href = LEGAL_ROUTES[legalKey][target];
    if (known.has(href)) return href;
  }

  // Listados, tags, autores y portada: la misma ruta con otro prefijo de idioma.
  const bare = path.replace(/^\/(en|ca)(?=\/|$)/, '');
  const swapped = bare === '/' || bare === '' ? homeHref(target) : `${LANG_PREFIX[target]}${bare}`;
  if (known.has(swapped)) return swapped;

  // Artículos: los slugs difieren entre idiomas, se emparejan por translationKey.
  const slug = bare.replace(/^\//, '').replace(/\/$/, '');
  for (const a of published) {
    if (a.data.lang !== from) continue;
    if (articleSlug(a) !== slug) continue;
    const key = a.data.translationKey ?? articleSlug(a);
    const translated = translationIndex.get(`${target}:${key}`);
    if (!translated) return null;
    return `${LANG_PREFIX[target]}/${translated}/`;
  }

  return null;
}

const hrefs = Object.fromEntries(LANGS.map((l) => [l, buildHref(l)])) as Record<Lang, string | null>;
const available = LANGS.filter((l) => hrefs[l] || l === lang);
---

{
  available.length > 1 && (
    <div class="relative">
      <div class="flex items-center gap-1 rounded-full border border-neutral-700 p-1 text-sm font-semibold">
        {available.map((l) => (
          <a
            href={hrefs[l] ?? currentPath}
            class:list={[
              'rounded-full px-3 py-1 transition-colors',
              lang === l ? 'bg-brand-pink text-white' : 'text-neutral-400 hover:text-white',
            ]}
            aria-current={lang === l ? 'page' : undefined}
            hreflang={l}
          >
            {LANG_LABEL[l]}
          </a>
        ))}
      </div>
    </div>
  )
}
