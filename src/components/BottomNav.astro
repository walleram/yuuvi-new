---
import { CATEGORIES, type Lang } from '../lib/site';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
  currentPath: string;
}

const { lang, currentPath } = Astro.props;

const items = [
  { slug: '', label: lang === 'es' ? 'Inicio' : 'Home', icon: 'home' },
  ...Object.entries(CATEGORIES).map(([slug, meta]) => ({
    slug,
    label: meta.label[lang],
    icon: slug,
  })),
];
---

<nav
  class="fixed inset-x-0 bottom-0 z-40 border-t border-neutral-800/60 bg-ink/90 backdrop-blur-xl md:hidden"
  aria-label="Bottom navigation"
>
  <div class="flex items-center justify-around px-2 pb-[env(safe-area-inset-bottom)]">
    {items.map((item) => {
      const href =
        item.slug === ''
          ? lang === 'es'
            ? '/'
            : '/en/'
          : `/${lang === 'es' ? '' : 'en/'}categoria/${item.slug}/`;
      const active =
        item.slug === ''
          ? currentPath === '/' || (lang === 'en' && currentPath === '/en/')
          : currentPath.includes(`/categoria/${item.slug}`);
      return (
        <a
          href={href}
          aria-label={item.label}
          class:list={[
            'flex flex-1 flex-col items-center gap-1 py-3 text-[10px] font-semibold transition-colors',
            active ? 'text-brand-pink' : 'text-neutral-400 hover:text-neutral-300',
          ]}
        >
          <Icon name={item.icon} active={active} />
          <span class="truncate">{item.label}</span>
        </a>
      );
    })}
  </div>
</nav>

<style>
  :global(padding-bottom) {
    padding-bottom: env(safe-area-inset-bottom);
  }
</style>
