---
import { getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { CATEGORIES, type Lang } from '../lib/site';
import { timeAgo } from '../lib/format';

interface Props {
  article: CollectionEntry<'articles'>;
  lang: Lang;
  size?: 'sm' | 'md' | 'lg';
}

const { article, lang, size = 'md' } = Astro.props;
const { data } = article;

const slug = article.id.replace(/^\/?(es|en)\//, '');
const href = `/${lang === 'es' ? '' : 'en/'}${slug}/`;

const catMeta = CATEGORIES[data.category];
const isSvg = data.coverImage.src.endsWith('.svg');
const sizesAttr = size === 'lg' ? '(max-width: 768px) 100vw, 50vw' : '(max-width: 768px) 100vw, 33vw';
const cover = await getImage({
  src: data.coverImage,
  widths: [400, 600, 800],
  sizes: sizesAttr,
  format: isSvg ? 'svg' : 'webp',
});

const sizes: Record<string, string> = {
  sm: 'aspect-[4/3]',
  md: 'aspect-[4/3]',
  lg: 'aspect-video',
};
---

<article class="group relative overflow-hidden rounded-3xl bg-neutral-900 ring-1 ring-neutral-800 transition-all hover:ring-brand-pink/50">
  <a href={href} class="block" aria-label={data.title}>
    {/* Imagen */}
    <div class:list={['relative w-full overflow-hidden', sizes[size]]}>
      <img
        src={cover.src}
        srcset={cover.srcSet?.attribute}
        sizes={sizesAttr}
        alt={data.coverAlt}
        width={cover.attributes.width}
        height={cover.attributes.height}
        loading={size === 'lg' ? 'eager' : 'lazy'}
        decoding="async"
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
      />
      {/* Overlay gradiente */}
      <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent" />

      {/* Badge de categoría */}
      <span
        class:list={[
          'absolute left-3 top-3 rounded-full px-3 py-1 text-xs font-bold backdrop-blur-md',
          'bg-ink/70 text-white',
        ]}
      >
        {catMeta.label[lang]}
      </span>

      {/* Tiempo relativo */}
      <span class="absolute right-3 top-3 rounded-full bg-ink/70 px-2.5 py-1 text-[11px] font-medium text-neutral-300 backdrop-blur-md">
        {timeAgo(data.pubDate, lang)}
      </span>
    </div>

    {/* Contenido */}
    <div class="p-4">
      <h3
        class:list={[
          'font-bold leading-snug text-white group-hover:text-brand-pink transition-colors',
          size === 'lg' ? 'text-2xl sm:text-3xl' : size === 'md' ? 'text-lg' : 'text-base',
        ]}
      >
        {data.title}
      </h3>
      {size !== 'sm' && (
        <p class="mt-2 line-clamp-2 text-sm text-neutral-400">{data.description}</p>
      )}
      <span class="mt-3 inline-block text-sm font-medium text-brand-pink">
        {size === 'lg' ? (lang === 'es' ? 'Leer artículo →' : 'Read article →') : ''}
      </span>
    </div>
  </a>
</article>
