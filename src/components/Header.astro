---
import { SITE, UI_TEXT, CATEGORIES, type Lang } from '../lib/site';
import LocaleSwitcher from './LocaleSwitcher.astro';

interface Props {
  lang: Lang;
  currentPath: string;
}

const { lang, currentPath } = Astro.props;
const t = UI_TEXT[lang];

const navItems = Object.entries(CATEGORIES).map(([slug, meta]) => ({
  slug,
  label: meta.label[lang],
}));
---

<header class="sticky top-0 z-40 border-b border-neutral-800/60 bg-ink/80 backdrop-blur-xl">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6">
    {/* Logo */}
    <a href={lang === 'es' ? '/' : '/en/'} class="group flex items-center gap-2" aria-label={SITE.name}>
      <span class="flex h-9 w-9 items-center justify-center rounded-2xl bg-gradient-to-br from-brand-pink to-brand-purple text-lg font-black text-white shadow-lg shadow-brand-pink/30 transition-transform group-hover:scale-105">
        Y
      </span>
      <span class="text-2xl font-black tracking-tight text-white">
        yuuvi<span class="text-brand-pink">.</span>
      </span>
    </a>

    {/* Navegación de escritorio */}
    <nav class="hidden items-center gap-1 md:flex" aria-label="Main navigation">
      <a
        href={lang === 'es' ? '/' : '/en/'}
        class:list={[
          'rounded-full px-4 py-2 text-sm font-semibold transition-colors',
          currentPath === '/' || (lang === 'en' && currentPath === '/en/')
            ? 'bg-white/10 text-white'
            : 'text-neutral-400 hover:text-white',
        ]}
      >
        {t.nav.home}
      </a>
      {navItems.map((item) => (
        <a
          href={`/${lang === 'es' ? '' : 'en/'}categoria/${item.slug}/`}
          class:list={[
            'rounded-full px-4 py-2 text-sm font-semibold transition-colors',
            currentPath.includes(`/categoria/${item.slug}`)
              ? 'bg-white/10 text-white'
              : 'text-neutral-400 hover:text-white',
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    {/* Selector de idioma + búsqueda (escritorio) */}
    <div class="hidden items-center gap-2 md:flex">
      <LocaleSwitcher lang={lang} currentPath={currentPath} />
    </div>
  </div>
</header>

<script>
  // Selector de idioma reutilizable (marcado como componente)
</script>
