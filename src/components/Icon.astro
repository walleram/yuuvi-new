---
interface Props {
  name: string;
  active?: boolean;
}

const { name, active = false } = Astro.props;
const stroke = active ? 'currentColor' : 'currentColor';
---

<svg
  width="22"
  height="22"
  viewBox="0 0 24 24"
  fill={name === 'home' ? (active ? 'currentColor' : 'none') : 'none'}
  stroke={stroke}
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {name === 'home' && (
    <>
      <path d="M3 9.5 12 3l9 6.5V21a1 1 0 0 1-1 1h-5.5v-6h-5v6H4a1 1 0 0 1-1-1V9.5z" />
    </>
  )}
  {name === 'moda' && (
    <>
      <circle cx="12" cy="12" r="9" />
      <path d="M8 8c2 2 6 2 8 0M8 16c2-2 6-2 8 0M12 3v18" />
    </>
  )}
  {name === 'estetica' && (
    <>
      <path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9L12 3z" />
      <path d="M19 15l.9 2.1L22 18l-2.1.9L19 21l-.9-2.1L16 18l2.1-.9L19 15z" />
    </>
  )}
  {name === 'cultura' && (
    <>
      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
    </>
  )}
  {name === 'gaming' && (
    <>
      <path d="M6 12h4M8 10v4" />
      <line x1="15" y1="11" x2="15.01" y2="11" />
      <line x1="18" y1="13" x2="18.01" y2="13" />
      <path d="M17.32 5H6.68a4 4 0 0 0-3.98 3.59c-.01.09-.02.18-.02.27L7 16h10l4.32-7.14a4.4 4.4 0 0 0-.9-4.37A4 4 0 0 0 17.32 5z" />
    </>
  )}
  {name === 'musica' && (
    <>
      <path d="M9 18V5l12-2v13" />
      <circle cx="6" cy="18" r="3" />
      <circle cx="18" cy="16" r="3" />
    </>
  )}
  {name === 'tecnologia' && (
    <>
      <rect x="4" y="4" width="16" height="16" rx="2" />
      <path d="M8 9h8M8 13h5" />
    </>
  )}
  {name === 'estilo-vida' && (
    <>
      <path d="M12 21c4-3.5 8-6.5 8-11a4 4 0 0 0-8-2 4 4 0 0 0-8 2c0 4.5 4 7.5 8 11z" />
    </>
  )}
</svg>
