---
import Layout from '@layouts/Layout.astro';
import ArticleCard from '@components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { SITE, UI_TEXT, type Lang } from '../../../lib/site';
import { articleUrl, collectTags, homeHref, LANGS, LANG_PREFIX, tagHref } from '../../../lib/articles';

interface Props {
  lang: Lang;
  tag: string;
}

export async function getStaticPaths() {
  const published = await getCollection('articles', ({ data }) => data.published);
  const paths: { params: { lang: string | undefined; tag: string }; props: Props }[] = [];

  for (const lang of LANGS) {
    const langArticles = published.filter((a) => a.data.lang === lang);
    for (const entry of collectTags(langArticles)) {
      paths.push({
        params: { lang: LANG_PREFIX[lang].replace(/^\//, '') || undefined, tag: entry.slug },
        props: { lang, tag: entry.slug },
      });
    }
  }
  return paths;
}

const { lang, tag } = Astro.props;
const t = UI_TEXT[lang];

const published = await getCollection('articles', ({ data }) => data.published);
const langArticles = published
  .filter((a) => a.data.lang === lang)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const entry = collectTags(langArticles).find((e) => e.slug === tag);

if (!entry) {
  return new Response(null, { status: 404 });
}

const canonicalURL = new URL(tagHref(entry.tag, lang), Astro.site!).toString();
const title = `#${entry.tag} | Yuuvi`;
const desctext: Record<Lang, string> = {
  es: `Artículos sobre ${entry.tag}: guía actualizada con lo que está pasando.`,
  en: `Articles about ${entry.tag}: an up-to-date guide to what is happening.`,
  ca: `Articles sobre ${entry.tag}: guia actualitzada amb el que està passant.`,
};
const description = desctext[lang];
const countLabel = `${entry.articles.length} ${entry.articles.length === 1 ? t.article : t.articles}`;
const shouldNoindex = entry.articles.length < 3;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': `${canonicalURL}#collection`,
    url: canonicalURL,
    name: title,
    description,
    inLanguage: lang,
    isPartOf: {
      '@type': 'WebSite',
      name: SITE.name,
      url: new URL(homeHref(lang), Astro.site!).toString(),
    },
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: entry.articles.length,
      itemListElement: entry.articles.map((a, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: a.data.title,
        url: articleUrl(a.id.replace(/^\/?(es|en|ca)\//, ''), lang, Astro.site!),
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: t.nav.home,
        item: new URL(homeHref(lang), Astro.site!).toString(),
      },
      { '@type': 'ListItem', position: 2, name: title, item: canonicalURL },
    ],
  },
];
---

<Layout
  title={title}
  description={description}
  lang={lang}
  canonicalURL={canonicalURL}
  jsonLd={jsonLd}
  rssHref={`${LANG_PREFIX[lang]}/rss.xml`}
  robots={shouldNoindex ? 'noindex, follow' : undefined}
>
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6">
    <nav aria-label="Breadcrumb" class="mb-6 flex items-center gap-2 text-sm text-neutral-400">
      <a href={homeHref(lang)} class="transition-colors hover:text-white">
        {t.nav.home}
      </a>
      <span aria-hidden="true">/</span>
      <span class="text-brand-pink">#{entry.tag}</span>
    </nav>

    <header class="mb-6">
      <h1 class="text-3xl font-black tracking-tight text-white sm:text-4xl">#{entry.tag}</h1>
      <p class="mt-2 text-sm text-neutral-400">
        {countLabel}
      </p>
    </header>

    {entry.articles.length >= 3 && (
      <section class="mb-8 max-w-3xl">
        <p class="leading-relaxed text-neutral-300">
          {lang === 'es' &&
            `Esta colección reúne ${countLabel.toLowerCase()} relacionados con #${entry.tag} en Yuuvi. Un repaso a tendencias, curiosidades y contenido seleccionado sobre este tema.`}
          {lang === 'en' &&
            `This collection brings together ${countLabel.toLowerCase()} related to #${entry.tag} on Yuuvi, covering trends, insights and hand-picked articles on the topic.`}
          {lang === 'ca' &&
            `Aquesta col·lecció reuneix ${countLabel.toLowerCase()} relacionats amb #${entry.tag} a Yuuvi amb un repàs a tendències, curiositats i contingut seleccionat sobre aquest tema.`}
        </p>
      </section>
    )}

    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {entry.articles.map((a) => (
        <ArticleCard article={a} lang={lang} size="md" />
      ))}
    </div>
  </div>
</Layout>
