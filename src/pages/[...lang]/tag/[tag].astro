---
import Layout from '@layouts/Layout.astro';
import ArticleCard from '@components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { SITE, type Lang } from '../../../lib/site';
import { articleUrl, collectTags, homeHref, tagHref } from '../../../lib/articles';

interface Props {
  lang: Lang;
  tag: string;
}

export async function getStaticPaths() {
  const published = await getCollection('articles', ({ data }) => data.published);
  const paths: { params: { lang: string | undefined; tag: string }; props: Props }[] = [];

  for (const lang of ['es', 'en'] as const) {
    const langArticles = published.filter((a) => a.data.lang === lang);
    for (const entry of collectTags(langArticles)) {
      paths.push({
        params: { lang: lang === 'en' ? 'en' : undefined, tag: entry.slug },
        props: { lang, tag: entry.slug },
      });
    }
  }
  return paths;
}

const { lang, tag } = Astro.props;

const published = await getCollection('articles', ({ data }) => data.published);
const langArticles = published
  .filter((a) => a.data.lang === lang)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const entry = collectTags(langArticles).find((e) => e.slug === tag);

if (!entry) {
  return new Response(null, { status: 404 });
}

const canonicalURL = new URL(tagHref(entry.tag, lang), Astro.site!).toString();
const title = `#${entry.tag} | Yuuvi`;
const description =
  lang === 'es'
    ? `Artículos sobre ${entry.tag}: guía actualizada con lo que está pasando.`
    : `Articles about ${entry.tag}: an up-to-date guide to what is happening.`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': `${canonicalURL}#collection`,
    url: canonicalURL,
    name: title,
    description,
    inLanguage: lang,
    isPartOf: {
      '@type': 'WebSite',
      name: SITE.name,
      url: new URL(homeHref(lang), Astro.site!).toString(),
    },
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: entry.articles.length,
      itemListElement: entry.articles.map((a, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: a.data.title,
        url: articleUrl(a.id.replace(/^\/?(es|en)\//, ''), lang, Astro.site!),
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: lang === 'es' ? 'Inicio' : 'Home',
        item: new URL(homeHref(lang), Astro.site!).toString(),
      },
      { '@type': 'ListItem', position: 2, name: title, item: canonicalURL },
    ],
  },
];
---

<Layout
  title={title}
  description={description}
  lang={lang}
  canonicalURL={canonicalURL}
  jsonLd={jsonLd}
  rssHref={lang === 'es' ? '/rss.xml' : '/en/rss.xml'}
>
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6">
    <nav aria-label="Breadcrumb" class="mb-6 flex items-center gap-2 text-sm text-neutral-400">
      <a href={homeHref(lang)} class="transition-colors hover:text-white">
        {lang === 'es' ? 'Inicio' : 'Home'}
      </a>
      <span aria-hidden="true">/</span>
      <span class="text-brand-pink">#{entry.tag}</span>
    </nav>

    <header class="mb-8">
      <h1 class="text-3xl font-black tracking-tight text-white sm:text-4xl">#{entry.tag}</h1>
      <p class="mt-2 text-sm text-neutral-400">
        {entry.articles.length}
        {lang === 'es'
          ? entry.articles.length === 1
            ? ' artículo'
            : ' artículos'
          : entry.articles.length === 1
            ? ' article'
            : ' articles'}
      </p>
    </header>

    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {entry.articles.map((a) => (
        <ArticleCard article={a} lang={lang} size="md" />
      ))}
    </div>
  </div>
</Layout>
