---
import Layout from '@layouts/Layout.astro';
import ArticleCard from '@components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { findAuthor, UI_TEXT, type Lang } from '../../../lib/site';
import { authorHref, authorSlug, collectAuthors, homeHref, LANGS, LANG_PREFIX } from '../../../lib/articles';

interface Props {
  lang: Lang;
  author: string;
}

export async function getStaticPaths() {
  const published = await getCollection('articles', ({ data }) => data.published);
  const paths: { params: { lang: string | undefined; author: string }; props: Props }[] = [];

  for (const lang of LANGS) {
    const langArticles = published.filter((a) => a.data.lang === lang);
    for (const name of collectAuthors(langArticles).keys()) {
      paths.push({
        params: { lang: LANG_PREFIX[lang].replace(/^\//, '') || undefined, author: authorSlug(name) },
        props: { lang, author: name },
      });
    }
  }
  return paths;
}

const { lang, author: authorName } = Astro.props;
const t = UI_TEXT[lang];

const published = await getCollection('articles', ({ data }) => data.published);
const articles = [...(collectAuthors(published.filter((a) => a.data.lang === lang)).get(authorName) ?? [])]
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const meta = findAuthor(authorName);
const canonicalURL = new URL(authorHref(authorName, lang), Astro.site!).toString();
const title = `${authorName} | Yuuvi`;
const desctext: Record<Lang, string> = {
  es: `${authorName} en Yuuvi: todos sus artículos sobre tendencias, cultura y tecnología.`,
  en: `${authorName} on Yuuvi: all their articles on trends, culture and tech.`,
  ca: `${authorName} a Yuuvi: tots els seus articles sobre tendències, cultura i tecnologia.`,
};
const description = desctext[lang];
const countLabel = `${articles.length} ${articles.length === 1 ? t.article : t.articles}`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfilePage',
    '@id': `${canonicalURL}#profile`,
    url: canonicalURL,
    name: title,
    description,
    inLanguage: lang,
    mainEntity: {
      '@type': 'Person',
      '@id': `${canonicalURL}#person`,
      name: authorName,
      description: meta?.bio[lang],
      jobTitle: meta?.role[lang],
      url: canonicalURL,
      worksFor: { '@type': 'Organization', name: 'Yuuvi', url: new URL(homeHref(lang), Astro.site!).toString() },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: t.nav.home,
        item: new URL(homeHref(lang), Astro.site!).toString(),
      },
      { '@type': 'ListItem', position: 2, name: authorName, item: canonicalURL },
    ],
  },
];

const colorByAuthor: Record<string, string> = {
  'valentina-ruiz': 'from-brand-pink to-brand-purple',
  'diego-morales': 'from-brand-yellow to-amber-500',
  'lucia-fernandez': 'from-brand-pink to-red-500',
  'sofia-vargas': 'from-brand-purple to-indigo-500',
};
const gradient = colorByAuthor[authorSlug(authorName)] ?? 'from-brand-pink to-brand-purple';
---

<Layout
  title={title}
  description={description}
  lang={lang}
  canonicalURL={canonicalURL}
  jsonLd={jsonLd}
  rssHref={`${LANG_PREFIX[lang]}/rss.xml`}
>
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6">
    <nav aria-label="Breadcrumb" class="mb-6 flex items-center gap-2 text-sm text-neutral-400">
      <a href={homeHref(lang)} class="transition-colors hover:text-white">
        {t.nav.home}
      </a>
      <span aria-hidden="true">/</span>
      <span class="text-brand-pink">{authorName}</span>
    </nav>

    <header class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-start">
      <div
        class:list={[
          'flex h-20 w-20 shrink-0 items-center justify-center rounded-3xl bg-gradient-to-br text-2xl font-black text-white',
          gradient,
        ]}
      >
        {meta?.initials ?? authorName.charAt(0).toUpperCase()}
      </div>
      <div>
        <h1 class="text-3xl font-black tracking-tight text-white sm:text-4xl">{authorName}</h1>
        {meta && <p class="mt-1 text-sm font-medium text-brand-pink">{meta.role[lang]}</p>}
        {meta && <p class="mt-3 max-w-2xl leading-relaxed text-neutral-400">{meta.bio[lang]}</p>}
        <p class="mt-3 text-sm text-neutral-400">
          {countLabel}
        </p>
      </div>
    </header>

    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {articles.map((a) => (
        <ArticleCard article={a} lang={lang} size="md" />
      ))}
    </div>
  </div>
</Layout>
