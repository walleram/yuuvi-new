---
import Layout from '@layouts/Layout.astro';
import ArticleCard from '@components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES, UI_TEXT, type Lang } from '../../../lib/site';
import { articleHref, articleSlug, categoryHref, LANG_PREFIX, LANGS } from '../../../lib/articles';

export function getStaticPaths() {
  const categorySlugs = Object.keys(CATEGORIES);
  const paths = [];
  for (const slug of categorySlugs) {
    for (const lang of LANGS) {
      // Español: sin prefijo /categoria/[slug]/
      paths.push({ params: { lang: LANG_PREFIX[lang].replace(/^\//, '') || undefined, slug }, props: { lang } });
    }
  }
  return paths;
}

const rawLang = Astro.params.lang as string | undefined;
const lang: Lang = rawLang === 'en' ? 'en' : rawLang === 'ca' ? 'ca' : 'es';
const t = UI_TEXT[lang];
const slug = Astro.params.slug as string;

const categoryMeta = CATEGORIES[slug];

const articles = (await getCollection('articles', ({ data }) =>
  data.published && data.lang === lang && data.category === slug
))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const colorBySlug: Record<string, string> = {
  cultura: 'from-brand-cyan to-blue-500',
  estetica: 'from-brand-pink to-red-500',
  gaming: 'from-brand-purple to-indigo-500',
  tecnologia: 'from-brand-lime to-green-500',
  musica: 'from-brand-yellow to-amber-500',
};

const iconBySlug: Record<string, string> = {
  cultura: '💬',
  estetica: '✨',
  gaming: '🎮',
  tecnologia: '🤖',
  musica: '🎧',
};

const title = `${categoryMeta.label[lang]} | Yuuvi`;
const description = categoryMeta.seoDescription[lang];
const canonicalURL = new URL(categoryHref(slug, lang), Astro.site!).toString();
const alternates = [
  ...LANGS.map((l) => ({ hreflang: l, href: new URL(categoryHref(slug, l), Astro.site!).toString() })),
  { hreflang: 'x-default', href: new URL(categoryHref(slug, 'es'), Astro.site!).toString() },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': `${canonicalURL}#collection`,
    url: canonicalURL,
    name: title,
    description,
    inLanguage: lang,
    isPartOf: {
      '@type': 'WebSite',
      name: 'Yuuvi',
      url: new URL(LANG_PREFIX[lang] || '/', Astro.site!).toString(),
    },
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: articles.length,
      itemListElement: articles.map((article, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: article.data.title,
        url: new URL(articleHref(articleSlug(article), lang), Astro.site!).toString(),
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: t.nav.home,
        item: new URL(LANG_PREFIX[lang] || '/', Astro.site!).toString(),
      },
      { '@type': 'ListItem', position: 2, name: title, item: canonicalURL },
    ],
  },
];
---

<Layout
  title={title}
  description={description}
  lang={lang}
  canonicalURL={canonicalURL}
  alternates={alternates}
  jsonLd={jsonLd}
  rssHref={`${LANG_PREFIX[lang]}/rss.xml`}
>
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6">
    <div class="mb-6 flex items-center gap-4">
      <span
        class:list={[
          'flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br text-2xl font-black text-white shadow-lg',
          colorBySlug[slug] ?? 'from-brand-pink to-brand-purple',
        ]}
      >
        {iconBySlug[slug] ?? '✨'}
      </span>
      <div>
        <h1 class="text-3xl font-black tracking-tight text-white">{categoryMeta.label[lang]}</h1>
        <p class="mt-1 text-sm text-neutral-400">
          {articles.length} {articles.length === 1 ? t.article : t.articles}
        </p>
      </div>
    </div>

    <section class="mb-8 max-w-3xl">
      <p class="leading-relaxed text-neutral-300">
        {categoryMeta.intro[lang]}
      </p>
    </section>

    {articles.length > 0 ? (
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {articles.map((article) => (
          <ArticleCard article={article} lang={lang} />
        ))}
      </div>
    ) : (
      <div class="rounded-3xl border border-dashed border-neutral-700 p-16 text-center">
        <p class="text-neutral-400">
          {t.comingSoon}
        </p>
      </div>
    )}
  </div>
</Layout>
